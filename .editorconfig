# Whitespace rules, enforced in CI-independent tooling by pre-commit
# (trailing-whitespace, end-of-file-fixer, mixed-line-ending, forbid-tabs).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,toml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
